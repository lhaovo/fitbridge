# FitBridge 环境变量（可选，全部有默认值）

# 监听地址与端口。默认 0.0.0.0:8080
FITBRIDGE_HOST=0.0.0.0
FITBRIDGE_PORT=8080

# 数据目录（SQLite + blobs + master.key 都在这里）
# 整个 FitBridge 的状态 = 这个目录，备份它就够了
FITBRIDGE_DATA_DIR=./data

# 管理员密码。留空则首次启动随机生成并打印到日志（仅一次）
# 重置：node apps/server/dist/cli/reset-password.js
FITBRIDGE_PASSWORD=

# 凭证加密主密钥（base64，32 字节）。
# 留空则自动生成并写入 <DATA_DIR>/master.key（0600）
# 生产环境建议用 openssl rand -base64 32 生成后固定下来
FITBRIDGE_MASTER_KEY=

# 文件保留策略（天）：L2 原始文件保留期，L3 派生文件缓存期
FITBRIDGE_FILE_RETENTION_DAYS=90
FITBRIDGE_DERIVED_TTL_DAYS=7

# 单次同步最多处理条数
FITBRIDGE_MAX_ITEMS_PER_RUN=100
