# FitBridge 环境变量（复制为 .env）

# 单用户管理员密码。留空则首次启动随机生成并打印到日志（仅打印一次）
FITBRIDGE_PASSWORD=

# 凭证加密主密钥（留空则首次启动生成并写入 data/master.key）
# 生产环境建议用 age/KMS 注入，或：openssl rand -base64 32
FITBRIDGE_MASTER_KEY=

# 服务端口与监听地址（默认仅本机可达）
FITBRIDGE_PORT=8080
FITBRIDGE_HOST=127.0.0.1

# 存储
FITBRIDGE_DATABASE_URL=postgres://fitbridge:fitbridge@postgres:5432/fitbridge
FITBRIDGE_REDIS_URL=redis://redis:6379
FITBRIDGE_S3_ENDPOINT=http://minio:9000
FITBRIDGE_S3_BUCKET=fitbridge
FITBRIDGE_S3_ACCESS_KEY=fitbridge
FITBRIDGE_S3_SECRET_KEY=fitbridge-secret
FITBRIDGE_S3_FORCE_PATH_STYLE=true

# 文件保留策略（天）：L2 原始文件保留期，L3 派生文件缓存期
FITBRIDGE_FILE_RETENTION_DAYS=90
FITBRIDGE_DERIVED_TTL_DAYS=7

# 单次同步最多处理条数
FITBRIDGE_MAX_ITEMS_PER_RUN=100
